GARMIN_EMAIL=your@email.com
GARMIN_PASSWORD=your_garmin_password
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=your_numeric_chat_id
ANTHROPIC_API_KEY=sk-ant-...
RUNNER_AGE=30
# Fallback IANA timezone, used only when no recent run is available. The
# coach normally auto-derives your timezone from the UTC offset of your
# latest activity, so you don't need to update this when travelling.
RUNNER_TIMEZONE=Europe/London
